{
  "name": "devel-without-a-cause-blog",
  "version": "0.0.0",
  "private": true,
  "description": "Source code for personal blog at https://blog.dwac.dev/.",
  "type": "module",
  "scripts": {
    "start": "node --run clean && node --run build:11ty && node --run build:browser && node --run 11ty -- --serve",
    "start:dev": "node --run clean && node --run build:11ty && node --run build:browser:dev && node --run 11ty:dev -- --serve",
    "start:prod": "node --run clean && node --run build:11ty && node --run build:browser:prod && node --run 11ty:prod -- --serve",
    "11ty": "node --run 11ty:dev --",
    "11ty:dev": "eleventy",
    "11ty:prod": "DWAC_ENV='prod' eleventy",
    "11ty:debug": "node --inspect-brk node_modules/@11ty/eleventy/cmd.js",
    "build": "node --run clean && node --run build:11ty && node --run build:browser && node --run 11ty",
    "build:dev": "node --run clean && node --run build:11ty && node --run build:browser:dev && node --run 11ty:dev",
    "build:prod": "node --run clean && node --run build:11ty && node --run build:browser:prod && node --run 11ty:prod",
    "build:debug": "node --run clean && node --run build:11ty && node --run build:browser:dev && node --run 11ty:debug",
    "build:11ty": "tsc -p tsconfig.11ty.json",
    "build:browser": "node --run build:browser:dev --",
    "build:browser:dev": "node --run check:browser && rolldown --config",
    "build:browser:prod": "node --run check:browser && DWAC_ENV='prod' rolldown --config",
    "check:browser": "tsc -p tsconfig.browser.json --noEmit",
    "test": "vitest run --typecheck",
    "test:11ty": "vitest run -p 11ty --typecheck",
    "test:browser": "vitest run -p client --typecheck",
    "test:browser:dev": "vitest watch -p client --typecheck --browser.headless false",
    "clean": "rm -rf dist/ && find src/ \\( -name '*.js' -o -name '*.js.map' \\) -delete",
    "deploy-test": "node --run netlify -- deploy -m \"Test deployment\" --alias",
    "font:update": "pyftsubset src/www/res/fonts/noto/noto-color-emoji-all.ttf --output-file=\"src/www/res/fonts/noto/noto-color-emoji.woff2\" --flavor=woff2 --text-file=\"src/www/res/fonts/noto/emojis.txt\"",
    "netlify": "netlify"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgp1130/blog.git"
  },
  "keywords": [
    "blog",
    "11ty"
  ],
  "author": "Doug Parker",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dgp1130/blog/issues"
  },
  "homepage": "https://github.com/dgp1130/blog#readme",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^3.0.6",
    "@atproto/common-web": "^0.5.0",
    "@parse5/tools": "^0.7.0",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@sindresorhus/slugify": "^1.1.0",
    "@types/clean-css": "^4.2.11",
    "@types/node": "^24.0.0",
    "@types/nunjucks": "^3.1.3",
    "@types/prismjs": "^1.26.0",
    "@vitest/browser-playwright": "^5.1.0",
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^5.1.1",
    "image-size": "^1.1.1",
    "marked": "^13.0.2",
    "marked-gfm-heading-id": "^4.0.0",
    "marked-highlight": "^2.1.3",
    "netlify-cli": "^23.0.0",
    "nunjucks": "^3.2.4",
    "parse5": "^8.0.0",
    "plausible-tracker": "^0.3.5",
    "playwright": "^1.55.0",
    "prismjs": "^1.30.0",
    "rolldown": "^1.3.0",
    "rollup-plugin-minify-html-literals": "^1.2.6",
    "ts-lit-plugin": "^2.0.2",
    "tslib": "^2.8.1",
    "typescript": "catalog:",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^3.13.4"
  }
}
