    "version": "0.2.0",
    "configurations": [
        {
            "name": "11ty Build",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": ["run", "--silent", "build"],
            "console": "internalConsole",
            "outputCapture": "std"
        },
        {
            "name": "11ty Test",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "sh",
            "runtimeArgs": ["-c", "pnpm run --silent clean && pnpm run --silent test:11ty"],
            "console": "internalConsole",
            "outputCapture": "std"
        }
    ]
}
